# Tomo Context Engine — environment
#
# Anthropic API key. Without it the app runs entirely on deterministic
# fallback content: every screen still works, the demo still closes the loop,
# and the debug panel labels each operation as "fallback" instead of "live".
ANTHROPIC_API_KEY=

# Model used for all five prompted operations.
TOMO_MODEL=claude-sonnet-4-5

# Where the SQLite file lives, relative to apps/tomo-context.
TOMO_DB_PATH=data/tomo.db

# Set to 1 to force fallback content even when a key is present
# (useful for rehearsing the offline demo).
TOMO_FORCE_FALLBACK=0
